# Model API Configuration (DO NOT COMMIT REAL SECRETS)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Hard cap per Gemini request in milliseconds; on timeout the agent falls back
# to its deterministic grounded answer (minimum 1000)
GEMINI_TIMEOUT_MS=30000
MODEL_OFFLINE_MODE=false
DATABASE_URL=sqlite:///./student_support.db

# Telemetry configuration
MODEL_CONTEXT_LIMIT=1048576
TOKEN_WARNING_THRESHOLD=0.80
TELEMETRY_LOG_PATH=logs/telemetry.jsonl