        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% -------------------------------------------------------------\n    %% STYLING: Exact pastel palette matching your original diagram\n    %% -------------------------------------------------------------\n    classDef userStyle fill:#FDE8CD,stroke:#E5A65E,stroke-width:1.5px,color:#222222;\n    classDef uiStyle fill:#E2D4E8,stroke:#A683BA,stroke-width:1.5px,color:#222222;\n    classDef appStyle fill:#BAE3F1,stroke:#6CB2D6,stroke-width:1.5px,color:#222222;\n    classDef aiStyle fill:#FBCBD0,stroke:#E27D87,stroke-width:1.5px,color:#222222;\n    classDef toolStyle fill:#CEEACD,stroke:#7FBF7E,stroke-width:1.5px,color:#222222;\n    classDef dataStyle fill:#FDE8CD,stroke:#E5A65E,stroke-width:1.5px,color:#222222;\n\n    %% -------------------------------------------------------------\n    %% 1. USERS LAYER\n    %% -------------------------------------------------------------\n    Student[\&quot;Student\&quot;]:::userStyle\n    Staff[\&quot;Support staff\&quot;]:::userStyle\n\n    %% -------------------------------------------------------------\n    %% 2. USER INTERFACE LAYER\n    %% -------------------------------------------------------------\n    StudentWeb[\&quot;Student web page\&quot;]:::uiStyle\n    StaffDash[\&quot;Staff dashboard\&quot;]:::uiStyle\n\n    %% -------------------------------------------------------------\n    %% 3. APPLICATION LAYER\n    %% -------------------------------------------------------------\n    Enquiry[\&quot;Enquiry handling\&quot;]:::appStyle\n    Validation[\&quot;Input validation\&quot;]:::appStyle\n    AccessCheck[\&quot;User access check\&quot;]:::appStyle\n    Guardrail[\&quot;Deterministic Iteration-0 guardrail&lt;br/&gt;(Hard refusal on grade/fee edits)\&quot;]:::appStyle\n\n    %% -------------------------------------------------------------\n    %% 4. AI &amp; ORCHESTRATION LAYER\n    %% -------------------------------------------------------------\n    Agent[\&quot;ReAct agent orchestrator&lt;br/&gt;(Sense &amp;rarr; Plan &amp;rarr; Act &amp;rarr; Observe | max_iter=3)\&quot;]:::aiStyle\n    Foundation[\&quot;Foundation model&lt;br/&gt;(gemini-3.5-flash-lite)\&quot;]:::aiStyle\n    DocSearch[\&quot;Document search &amp;amp; RAG\&quot;]:::aiStyle\n    Memory[\&quot;Sliding-window memory&lt;br/&gt;(6-turn FIFO + rolling summary)\&quot;]:::aiStyle\n\n    %% -------------------------------------------------------------\n    %% 5. TOOLS LAYER\n    %% -------------------------------------------------------------\n    Timetable[\&quot;Timetable lookup\&quot;]:::toolStyle\n    Ticket[\&quot;Ticket management&lt;br/&gt;(student_confirmed=True)\&quot;]:::toolStyle\n\n    %% -------------------------------------------------------------\n    %% 6. DATA LAYER\n    %% -------------------------------------------------------------\n    ActivityLog[(\&quot;Activity &amp;amp; telemetry log&lt;br/&gt;(agent_telemetry.jsonl)\&quot;)]:::dataStyle\n    CurrentCase[(\&quot;Current case &amp;amp; session store&lt;br/&gt;(GDPR purge &amp;amp; 30-day TTL)\&quot;)]:::dataStyle\n    ApprovedDocs[(\&quot;Approved university&lt;br/&gt;documents\&quot;)]:::dataStyle\n    TimetableDB[(\&quot;Timetable database\&quot;)]:::dataStyle\n    TicketDB[(\&quot;Ticket database\&quot;)]:::dataStyle\n\n    %% -------------------------------------------------------------\n    %% CONNECTIONS (Strict Top-Down Flow)\n    %% -------------------------------------------------------------\n    %% Users to UI\n    Student --&gt; StudentWeb\n    Staff --&gt; StaffDash\n\n    %% UI to App Layer\n    StudentWeb --&gt; Enquiry\n    Enquiry --&gt; Validation\n    Validation --&gt; AccessCheck\n    AccessCheck --&gt; Guardrail\n\n    %% Guardrail logic\n    Guardrail --&gt;|\&quot;Approved query\&quot;| Agent\n    Guardrail -.-&gt;|\&quot;Refusal (&amp;lt;10ms)\&quot;| StudentWeb\n\n    %% AI Core interactions\n    Agent &lt;--&gt; Foundation\n    Agent &lt;--&gt; DocSearch\n    Agent &lt;--&gt; Memory\n\n    %% AI to Tools\n    Agent --&gt; Timetable\n    Agent --&gt; Ticket\n\n    %% Downstream Data access\n    Agent --&gt; ActivityLog\n    Memory &lt;--&gt; CurrentCase\n    DocSearch --&gt; ApprovedDocs\n    Timetable &lt;--&gt; TimetableDB\n    Ticket &lt;--&gt; TicketDB\n\n    %% Staff integration\n    Ticket --&gt; StaffDash&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="IOh0COTX5rIeNkCGdE8Q-47">
